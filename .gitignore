# Julia
Manifest.toml
*.jl.cov
*.jl.mem
LocalPreferences.toml

# Docs build output and Literate-generated tutorial pages
docs/build/
docs/src/tutorials/
docs/src/explanation/crosscheck.md

# Monte Carlo run outputs (the full-sweep JSON is tracked as provenance)
tools/artifacts/*
!tools/artifacts/
!tools/artifacts/mhtotdev_mc_full.json

# Benchmark outputs (the timing JSONs are tracked as provenance; the input
# sample files are not, as the measured record is not public)
bench/results/*
!bench/results/
!bench/results/*.json

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store

# Command line build (juliac bundle) and the explorer's local Plotly copy
cli/build/
app/web/ui/vendor/

# Python bytecode
__pycache__/

# Local-only: paper manuscript sources and build outputs (figures and
# figure scripts under paper/ that are already tracked stay tracked)
paper/main.*
paper/refs.bib
paper/IEEE*
paper/scripts/
paper/figures/fig[0-9]_*.pdf

# Local assistant settings and notes
.claude/
[Cc][Ll][Aa][Uu][Dd][Ee].md

# Desktop shell: Rust build output and generated schemas
app/desktop/target/
app/desktop/gen/
app/desktop/dist/
.pytest_cache/
.ruff_cache/
*.egg-info/
tools/artifacts/cache/

# Python
__pycache__/
*.pyc
