# Julia
Manifest.toml
*.jl.cov
*.jl.mem
LocalPreferences.toml

# Docs build output and Literate-generated tutorial pages
docs/build/
docs/src/tutorials/

# Monte Carlo run outputs (the full-sweep JSON is tracked as provenance)
tools/artifacts/*
!tools/artifacts/
!tools/artifacts/mhtotdev_mc_full.json

# Benchmark outputs (the timing JSONs are tracked as provenance; the input
# sample files are not, as the measured record is not public)
bench/results/*
!bench/results/
!bench/results/*.json

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
